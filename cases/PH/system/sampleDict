FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      sampleDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //
type sets;

setFormat csv;

interpolationScheme cellPoint;

fields
(
    U
    k       
);

sets
(

    X0H
    {
        type        lineFace;
        axis        y;

        start       (0.05 0 0);
        end         (0.05 5 0);
    }

    X1H
    {
        type        lineFace;
        axis        y;

        start       (1 0 0);
        end         (1 5 0);
    }

    X2H
    {
        type        lineFace;
        axis        y;

        start       (2 0 0);
        end         (2 5 0);
    }

    X4H
    {
        type        lineFace;
        axis        y;

        start       (4 0 0);
        end         (4 5 0);
    }

    X6H
    {
        type        lineFace;
        axis        y;

        start       (6 0 0);
        end         (6 5 0);
    }

    X8H
    {
        type        lineFace;
        axis        y;

        start       (8 0 0);
        end         (8 5 0);
    }
   
);
